#include <Arduino.h>

// --- Motor pins (using original definitions) ---
const int LEFT_FORWARD = 8;
const int LEFT_BACKWARD = 9;
const int RIGHT_FORWARD = 7;
const int RIGHT_BACKWARD = 6;

// --- Sensor pins ---
const int TRIG_FRONT = 12;
const int ECHO_FRONT = 11;
const int TRIG_LEFT = 2;
const int ECHO_LEFT = 3;

// --- Distance thresholds (cm) ---
const int STOP_DISTANCE = 10;  // Obstacle threshold
const int TARGET_LEFT = 10;    // Desired distance from wall
const int TOLERANCE = 0;       // Acceptable error

// --- Wall Following Adjustment ---
const float Kp = 3.0;        // Proportional constant for wall adjustments
const int SOFT_ADJUST_BASE = 50;  // Base delay (ms) for soft adjustments

// --- Obstacle Avoidance Delays (ms) ---
const int OBSTACLE_REVERSE_DELAY = 500;  // Longer reverse delay when obstacle detected
const int OBSTACLE_TURN_DELAY = 200;     // Sharp turn delay during obstacle avoidance

// -------------------------------------------------
// --- Sensor Function ---
// Get distance from an ultrasonic sensor (in cm)
int getDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  long duration = pulseIn(echoPin, HIGH);
  return duration * 0.034 / 2;
}

// -------------------------------------------------
// --- Basic Motor Control Functions ---
void moveForward() {
  Serial.println("Moving Forward...");
  digitalWrite(LEFT_FORWARD, HIGH);
  digitalWrite(LEFT_BACKWARD, LOW);
  digitalWrite(RIGHT_FORWARD, HIGH);
  digitalWrite(RIGHT_BACKWARD, LOW);
}

void moveBackward() {
  Serial.println("Moving Backward...");
  digitalWrite(LEFT_FORWARD, LOW);
  digitalWrite(LEFT_BACKWARD, HIGH);
  digitalWrite(RIGHT_FORWARD, LOW);
  digitalWrite(RIGHT_BACKWARD, HIGH);
}

void stopRobot() {
  Serial.println("Stopping...");
  digitalWrite(LEFT_FORWARD, LOW);
  digitalWrite(LEFT_BACKWARD, LOW);
  digitalWrite(RIGHT_FORWARD, LOW);
  digitalWrite(RIGHT_BACKWARD, LOW);
}

// -------------------------------------------------
// --- Sharp Turn Functions (for Obstacle Avoidance) ---
// These perform a pivot turn for a sharp maneuver.
void sharpTurnRight() {
  Serial.println("Sharp Turn Right...");
  // Right motor goes in reverse; left motor runs forward.
  digitalWrite(RIGHT_FORWARD, LOW);
  digitalWrite(RIGHT_BACKWARD, HIGH);
  digitalWrite(LEFT_FORWARD, HIGH);
  digitalWrite(LEFT_BACKWARD, LOW);
}

void sharpTurnLeft() {
  Serial.println("Sharp Turn Left...");
  // Left motor goes in reverse; right motor runs forward.
  digitalWrite(LEFT_FORWARD, LOW);
  digitalWrite(LEFT_BACKWARD, HIGH);
  digitalWrite(RIGHT_FORWARD, HIGH);
  digitalWrite(RIGHT_BACKWARD, LOW);
}

// -------------------------------------------------
// --- Soft Adjustment Functions (for Wall Following) ---
// These functions make small adjustments without a full pivot turn.

void softAdjustRight(int duration) {
  Serial.println("Soft Adjust Right...");
  // To turn right gently, momentarily stop the left motor while the right motor keeps running.
  digitalWrite(LEFT_FORWARD, LOW);
  digitalWrite(LEFT_BACKWARD, LOW);
  // Ensure the right motor is running forward.
  digitalWrite(RIGHT_FORWARD, HIGH);
  digitalWrite(RIGHT_BACKWARD, LOW);
  delay(duration);
  moveForward();
}

void softAdjustLeft(int duration) {
  Serial.println("Soft Adjust Left...");
  // To turn left gently, momentarily stop the right motor while the left motor keeps running.
  digitalWrite(RIGHT_FORWARD, LOW);
  digitalWrite(RIGHT_BACKWARD, LOW);
  // Ensure the left motor is running forward.
  digitalWrite(LEFT_FORWARD, HIGH);
  digitalWrite(LEFT_BACKWARD, LOW);
  delay(duration);
  moveForward();
}

// -------------------------------------------------
void setup() {
  pinMode(LEFT_FORWARD, OUTPUT);
  pinMode(LEFT_BACKWARD, OUTPUT);
  pinMode(RIGHT_FORWARD, OUTPUT);
  pinMode(RIGHT_BACKWARD, OUTPUT);
  
  pinMode(TRIG_FRONT, OUTPUT);
  pinMode(ECHO_FRONT, INPUT);
  pinMode(TRIG_LEFT, OUTPUT);
  pinMode(ECHO_LEFT, INPUT);
  
  Serial.begin(9600);
}

void loop() {
  // Read sensor distances.
  int frontDist = getDistance(TRIG_FRONT, ECHO_FRONT);
  int leftDist = getDistance(TRIG_LEFT, ECHO_LEFT);
  
  Serial.print("Front: ");
  Serial.print(frontDist);
  Serial.print(" cm, Left: ");
  Serial.print(leftDist);
  Serial.println(" cm");
  
  // --- Obstacle Avoidance ---
  if (frontDist > 0 && frontDist < STOP_DISTANCE) {
    Serial.println("Obstacle detected! Executing sharp avoidance maneuver.");
    moveBackward();
    delay(OBSTACLE_REVERSE_DELAY);  // Back up a bit longer.
    stopRobot();
    delay(50);
    
    // For obstacle avoidance, perform a sharp pivot turn.
    // (Here we choose a sharp right turn, but you can change to sharpTurnLeft() if needed.)
    sharpTurnLeft();
    delay(OBSTACLE_TURN_DELAY);
    moveForward();
    
    // Skip wall-following adjustments on this iteration.
    return;
  }
  
  // --- Wall Following (Soft Adjustments) ---
  // Calculate the error from the desired left distance.
  // (Positive error: too close to the wall; negative: too far.)
  int error = TARGET_LEFT - leftDist;
  int correction = Kp * error;  // This determines the magnitude of adjustment.
  int adjustDelay = SOFT_ADJUST_BASE + abs(correction);  // Delay grows with error magnitude.
  
  // Perform soft adjustments to maintain the wall distance.
  if (error > TOLERANCE) {
    // Too close to the wall → gently adjust right.
    softAdjustRight(adjustDelay);
  } else if (error < -TOLERANCE) {
    // Too far from the wall → gently adjust left.
    softAdjustLeft(adjustDelay);
  } else {
    // If within tolerance, continue straight.
    moveForward();
  }
  
  delay(50);  // Short delay for loop stability.
}
