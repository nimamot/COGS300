/**
 * Arduino Robot with Line Following and Wall Following capabilities
 * Features transition from line following to wall following mode
 */

// Motor Pins
int motorAPin_A = 8;    
int motorAPin_B = 9;    
int motorBPin_A = 7;    
int motorBPin_B = 6;    

// IR Array Connections
const int L_IR = A2;    
const int M_IR = A1;    
const int R_IR = A0;    

// Ultrasonic sensor pins
#define TRIG_FRONT 10     // Front ultrasonic trigger
#define ECHO_FRONT 13     // Front ultrasonic echo
#define TRIG_LEFT 2       // Left ultrasonic trigger
#define ECHO_LEFT 3       // Left ultrasonic echo
#define TRIG_RIGHT 12     // Right ultrasonic trigger
#define ECHO_RIGHT 11     // Right ultrasonic echo

// Constants for PID control (for wall following)
float Kp = 1.5;           // Proportional constant
float Ki = 0.05;          // Integral constant
float Kd = 0.8;           // Derivative constant

// Constants for wall following
const int TARGET_DISTANCE = 15;   // Target distance from wall in cm
const int FRONT_THRESHOLD = 15;   // Distance to trigger turning (front sensor)
const int MAX_DISTANCE = 200;     // Maximum measurable distance
const int BASE_SPEED = 150;       // Base motor speed (0-255)
const int MAX_SPEED = 175;        // Maximum motor speed
const int TURN_SPEED = 125;       // Speed for turning

// Variables for PID calculation
float lastError = 0;
float integral = 0;

// Variables to store ultrasonic sensor readings
long durationFront, durationLeft, durationRight;
int distanceFront, distanceLeft, distanceRight;

// Threshold to determine white vs black for line following
// For your sensors, LOWER values indicate WHITE line
const int threshold = 200;  // Values below this are considered white line

// Motor speed settings for line following
const int forwardSpeed = 200;  // Reduced base speed for better accuracy
const int correctionSpeed = 120;  // Slower speed for minor corrections
const int turnSpeed = 230;  // Increased for sharper turns

// Delay values for line following
const int sharpTurnDelay = 250;  // Slightly reduced for faster response
const int softAdjustmentDelay = 20;  // For soft corrections
const int loopDelay = 40;  // Further reduced for quicker response

// Stage control flags
bool startLine = true;   // Start with line following
bool startWall = false;  // Wall following initially disabled
bool startSweep = false; // Sweeping mode initially disabled

// Detection threshold for when to transition from line to wall
const int WALL_DETECTION_THRESHOLD = 20; // Distance in cm that indicates a wall is close enough

void setup() {
  // Set motor pins as outputs
  pinMode(motorAPin_A, OUTPUT);
  pinMode(motorAPin_B, OUTPUT);
  pinMode(motorBPin_A, OUTPUT);
  pinMode(motorBPin_B, OUTPUT);
  
  // Set IR sensor pins as inputs
  pinMode(L_IR, INPUT);
  pinMode(M_IR, INPUT);
  pinMode(R_IR, INPUT);
  
  // Setup ultrasonic sensor pins
  pinMode(TRIG_FRONT, OUTPUT);
  pinMode(ECHO_FRONT, INPUT);
  pinMode(TRIG_LEFT, OUTPUT);
  pinMode(ECHO_LEFT, INPUT);
  pinMode(TRIG_RIGHT, OUTPUT);
  pinMode(ECHO_RIGHT, INPUT);
  
  // Initialize serial communication for debugging
  Serial.begin(9600);
  
  // Stop motors at startup
  stopMotors();
  
  // Wait for a moment before starting
  delay(2000);
}

void loop() {
  // Check which mode we're currently in
  if (startLine) {
    lineFollowingMode();
    
    // Check if wall is detected to transition
    readSensors(); // Read ultrasonic sensors
    
    // If either left or right wall is detected within threshold
    if (distanceLeft < WALL_DETECTION_THRESHOLD || distanceRight < WALL_DETECTION_THRESHOLD) {
      // Transition to wall following mode
      startLine = false;
      startWall = true;
      startSweep = false;
      
      Serial.println("MODE TRANSITION: Line Following → Wall Following");
      
      // Brief pause to stabilize before mode switch
      stopMotors();
      delay(500);
    }
  } 
  else if (startWall) {
    wallFollowingMode();
    
    // Add any transitions from wall following to other modes here if needed
  }
  else if (startSweep) {
    sweepMode();
    
    // Add any transitions from sweep mode to other modes here if needed
  }
  
  // Small delay for stability
  delay(50);
}

//========================
// LINE FOLLOWING FUNCTIONS
//========================

// Line following mode - calls the original line following code
void lineFollowingMode() {
  // Read IR sensor values
  int leftValue = analogRead(L_IR);
  int middleValue = analogRead(M_IR);
  int rightValue = analogRead(R_IR);
  
  // Convert analog readings to binary
  // For your sensors: LOW value = WHITE line (1), HIGH value = NO line (0)
  bool leftSensor = (leftValue < threshold) ? 1 : 0;
  bool middleSensor = (middleValue < threshold) ? 1 : 0;
  bool rightSensor = (rightValue < threshold) ? 1 : 0;
  
  // Print sensor values for debugging
  Serial.print("LINE MODE - Left: ");
  Serial.print(leftValue);
  Serial.print(" (");
  Serial.print(leftSensor);
  Serial.print(") Middle: ");
  Serial.print(middleValue);
  Serial.print(" (");
  Serial.print(middleSensor);
  Serial.print(") Right: ");
  Serial.print(rightValue);
  Serial.print(" (");
  Serial.print(rightSensor);
  Serial.println(")");
  
  // Line following logic with improved prioritization of turns
  if (leftSensor == 1 && middleSensor == 1 && rightSensor == 0) {
    // Left sensor detects line - sharp turn left (highest priority)
    Serial.println("Action: Sharp Left Turn");
    sharpLeft();
    return; // Skip the rest of the loop to respond immediately
  } 
  else if (rightSensor == 1 && middleSensor == 1 && leftSensor == 0) {
    // Right sensor detects line - sharp turn right (highest priority)
    Serial.println("Action: Sharp Right Turn");
    sharpRight();
    return; // Skip the rest of the loop to respond immediately
  }
  else if (leftSensor == 0 && middleSensor == 0 && rightSensor == 1) {
    // Left and middle sensors detect line - medium turn left
    Serial.println("Action: Medium Left Turn");
    adjustLeft();
  }
  else if (rightSensor == 0 && middleSensor == 0 && leftSensor == 1) {
    // Right and middle sensors detect line - medium turn right
    Serial.println("Action: Medium Right Turn");
    adjustRight();
  }
  else if (middleSensor == 1 && leftSensor == 0 && rightSensor == 0) {
    // Only middle sensor detects line, go straight
    Serial.println("Action: Move Forward");
    moveMotorForward(forwardSpeed, forwardSpeed);
  } 
  else if (leftSensor == 0 && middleSensor == 0 && rightSensor == 0) {
    // No sensors detect white line, lost the line
    Serial.println("Action: Searching for Line");
    searchForLine();
  }
  else if (leftSensor == 1 && middleSensor == 1 && rightSensor == 1) {
    // All sensors detect white, at intersection
    Serial.println("Action: At Intersection");
    moveMotorForward(forwardSpeed, forwardSpeed);
    delay(200);
  }
  
  // Reduced delay between readings for more responsive control
  delay(loopDelay);
}

// Dedicated function for soft left adjustment
void adjustLeft() {
  moveMotorForward(correctionSpeed, forwardSpeed);
  delay(softAdjustmentDelay);
}

// Dedicated function for soft right adjustment
void adjustRight() {
  moveMotorForward(forwardSpeed, correctionSpeed);
  delay(softAdjustmentDelay);
}

void searchForLine() {
  // Enhanced search pattern with more backward movement
  
  // Back up for longer
  moveMotorBackward();
  delay(350); // Increased from 200 for more backward movement
  stopMotors();
  delay(50);
}

