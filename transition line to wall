// Wall following mode - calls the original wall following code
void wallFollowingMode() {
  // Read distance from all ultrasonic sensors
  readSensors();
  
  // Print sensor readings with mode indicator
  Serial.print("WALL MODE - Front: ");
  Serial.print(distanceFront);
  Serial.print(" cm | Left: ");
  Serial.print(distanceLeft);
  Serial.print(" cm | Right: ");
  Serial.print(distanceRight);
  Serial.println(" cm");
  
  // Wall following logic with obstacle avoidance
  followWall();
}

// Placeholder for the third mode - if needed
void sweepMode() {
  Serial.println("SWEEP MODE");
  // Add sweep mode code here if needed
}

void readSensors() {
  // Read front sensor
  digitalWrite(TRIG_FRONT, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_FRONT, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_FRONT, LOW);
  durationFront = pulseIn(ECHO_FRONT, HIGH, 30000);
  distanceFront = durationFront * 0.034 / 2;
  
  // Read left sensor
  digitalWrite(TRIG_LEFT, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_LEFT, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_LEFT, LOW);
  durationLeft = pulseIn(ECHO_LEFT, HIGH, 30000);
  distanceLeft = durationLeft * 0.034 / 2;
  
  // Read right sensor
  digitalWrite(TRIG_RIGHT, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_RIGHT, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_RIGHT, LOW);
  durationRight = pulseIn(ECHO_RIGHT, HIGH, 30000);
  distanceRight = durationRight * 0.034 / 2;
  
  // Constrain values to avoid errors
  if (distanceFront <= 0 || distanceFront > MAX_DISTANCE) distanceFront = MAX_DISTANCE;
  if (distanceLeft <= 0 || distanceLeft > MAX_DISTANCE) distanceLeft = MAX_DISTANCE;
  if (distanceRight <= 0 || distanceRight > MAX_DISTANCE) distanceRight = MAX_DISTANCE;
}

void followWall() {
  // Check if there's an obstacle in front
  if (distanceFront < FRONT_THRESHOLD) {
    // Obstacle detected in front, turn to avoid it
    if (distanceLeft > distanceRight) {
      // More space on the left, turn left
      turnRight();
      Serial.println("Obstacle ahead! Turning right.");
    } else {
      // More space on the right, turn right
      turnLeft();
      Serial.println("Obstacle ahead! Turning left.");
    }
    return;
  }
  
  // Determine which wall to follow
  if (distanceLeft < distanceRight && distanceLeft < 50) {
    // Follow left wall if it's closer
    followLeftWall();
  } else if (distanceRight < 50) {
    // Follow right wall if it's closer
    followRightWall();
  } else {
    // No wall detected nearby, go straight and look for a wall
    moveForward(BASE_SPEED, BASE_SPEED);
    Serial.println("No wall detected, moving forward.");
  }
}

void followLeftWall() {
  // PID control for left wall following
  int error = distanceLeft - TARGET_DISTANCE;
  
  // Calculate integral
  integral = integral + error;
  integral = constrain(integral, -100, 100);  // Prevent integral windup
  
  // Calculate derivative
  float derivative = error - lastError;
  
  // Calculate PID output
  float pidOutput = (Kp * error) + (Ki * integral) + (Kd * derivative);
  
  // Adjust motor speeds based on PID output
  int leftSpeed = BASE_SPEED - pidOutput;
  int rightSpeed = BASE_SPEED + pidOutput;
  
  // Constrain motor speeds to valid range
  leftSpeed = constrain(leftSpeed, 0, MAX_SPEED);
  rightSpeed = constrain(rightSpeed, 0, MAX_SPEED);
  
  // Move the robot
  moveForward(leftSpeed, rightSpeed);
  
  // Store current error for next iteration
  lastError = error;
  
  Serial.print("Following left wall | PID Output: ");
  Serial.print(pidOutput);
  Serial.print(" | Motors L/R: ");
  Serial.print(leftSpeed);
  Serial.print("/");
  Serial.println(rightSpeed);
}

void followRightWall() {
  // PID control for right wall following
  int error = TARGET_DISTANCE - distanceRight;
  
  // Calculate integral
  integral = integral + error;
  integral = constrain(integral, -100, 100);  // Prevent integral windup
  
  // Calculate derivative
  float derivative = error - lastError;
  
  // Calculate PID output
  float pidOutput = (Kp * error) + (Ki * integral) + (Kd * derivative);
  
  // Adjust motor speeds based on PID output
  int leftSpeed = BASE_SPEED + pidOutput;
  int rightSpeed = BASE_SPEED - pidOutput;
  
  // Constrain motor speeds to valid range
  leftSpeed = constrain(leftSpeed, 0, MAX_SPEED);
  rightSpeed = constrain(rightSpeed, 0, MAX_SPEED);
  
  // Move the robot
  moveForward(leftSpeed, rightSpeed);
  
  // Store current error for next iteration
  lastError = error;
  
  Serial.print("Following right wall | PID Output: ");
  Serial.print(pidOutput);
  Serial.print(" | Motors L/R: ");
  Serial.print(leftSpeed);
  Serial.print("/");
  Serial.println(rightSpeed);
}

//========================
// COMMON MOTOR FUNCTIONS 
//========================

// Common function for moving forward - compatible with both systems
void moveForward(int leftSpeed, int rightSpeed) {
  analogWrite(motorAPin_A, leftSpeed);
  digitalWrite(motorAPin_B, LOW);

  analogWrite(motorBPin_A, rightSpeed);
  digitalWrite(motorBPin_B, LOW);
}

// Line following specific function - maintains backward movement
void moveMotorForward(int speedA, int speedB) {
  // Variable speed control for each motor for smoother adjustments
  analogWrite(motorAPin_A, speedA);
  digitalWrite(motorAPin_B, LOW);

  analogWrite(motorBPin_A, speedB);
  digitalWrite(motorBPin_B, LOW);
}

void moveMotorBackward() {
  // Stronger backward movement for line search recovery
  digitalWrite(motorAPin_A, LOW);
  analogWrite(motorAPin_B, 120); // Increased from 100
  
  digitalWrite(motorBPin_A, LOW);
  analogWrite(motorBPin_B, 120); // Increased from 100
}

void sharpRight() {
  // Faster, sharper right turn
  digitalWrite(motorAPin_A, LOW);
  analogWrite(motorAPin_B, 70); // Added slight backward motion for sharper pivot
  
  analogWrite(motorBPin_A, turnSpeed);
  digitalWrite(motorBPin_B, LOW);

  delay(sharpTurnDelay);
}

void sharpLeft() {
  // Faster, sharper left turn
  analogWrite(motorAPin_A, turnSpeed);
  digitalWrite(motorAPin_B, LOW);
  
  digitalWrite(motorBPin_A, LOW);
  analogWrite(motorBPin_B, 70); // Added slight backward motion for sharper pivot

  delay(sharpTurnDelay);
}

void turnLeft() {
  analogWrite(motorAPin_A, 0);
  analogWrite(motorAPin_B, TURN_SPEED);
  analogWrite(motorBPin_A, BASE_SPEED);
  analogWrite(motorBPin_B, 0);
  delay(500);  // Adjust this value to control turning duration
}

void turnRight() {
  analogWrite(motorAPin_A, BASE_SPEED);
  analogWrite(motorAPin_B, 0);
  analogWrite(motorBPin_A, 0);
  analogWrite(motorBPin_B, TURN_SPEED);
  delay(500);  // Adjust this value to control turning duration
}

void stopMotors() {
  // Stop both motors
  digitalWrite(motorAPin_A, LOW);
  digitalWrite(motorAPin_B, LOW);
  digitalWrite(motorBPin_A, LOW);
  digitalWrite(motorBPin_B, LOW);
}
